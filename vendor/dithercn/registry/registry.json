{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "homepage": "https://dithercn.dev",
  "items": [
    {
      "name": "dither-tokens",
      "type": "registry:item",
      "title": "Dither tokens",
      "description": "CSS variables every dithercn piece reads: ink, paper, cell size, bloom strength and the named colour palette (blue, purple, green, pink, orange, red, grey), tuned for light and dark.",
      "cssVars": {
        "theme": {
          "color-dither-ink": "var(--dither-ink)",
          "color-dither-paper": "var(--dither-paper)",
          "color-dither-blue": "var(--dither-color-blue)",
          "color-dither-purple": "var(--dither-color-purple)",
          "color-dither-green": "var(--dither-color-green)",
          "color-dither-pink": "var(--dither-color-pink)",
          "color-dither-orange": "var(--dither-color-orange)",
          "color-dither-red": "var(--dither-color-red)",
          "color-dither-grey": "var(--dither-color-grey)"
        }
      },
      "css": {
        "@layer base": {
          ":root": {
            "--dither-ink": "var(--primary)",
            "--dither-paper": "var(--background)",
            "--dither-cell": "3px",
            "--dither-color-blue": "oklch(0.56 0.18 248)",
            "--dither-color-purple": "oklch(0.53 0.22 302)",
            "--dither-color-green": "oklch(0.58 0.15 152)",
            "--dither-color-pink": "oklch(0.58 0.21 355)",
            "--dither-color-orange": "oklch(0.64 0.17 52)",
            "--dither-color-red": "oklch(0.55 0.21 27)",
            "--dither-color-grey": "oklch(0.55 0 0)",
            "--dither-bloom": "0.6"
          },
          ".dark": {
            "--dither-ink": "var(--primary)",
            "--dither-paper": "var(--background)",
            "--dither-cell": "3px",
            "--dither-color-blue": "oklch(0.72 0.14 240)",
            "--dither-color-purple": "oklch(0.7 0.18 304)",
            "--dither-color-green": "oklch(0.78 0.17 152)",
            "--dither-color-pink": "oklch(0.74 0.17 354)",
            "--dither-color-orange": "oklch(0.79 0.15 62)",
            "--dither-color-red": "oklch(0.68 0.2 25)",
            "--dither-color-grey": "oklch(0.66 0 0)",
            "--dither-bloom": "1"
          }
        }
      }
    },
