    "@tailwindcss/cli": "^4.3.5",
    "@types/node": "22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "clsx": "^2.1.1",
    "echarts": "^6.1.0",
    "esbuild": "^0.28.2",
    "playwright": "^1.65.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
